{
  "name": "mon22r",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @mon22r/server build && pnpm --filter @mon22r/miniapp build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false --noEmit",
    "test": "vitest run",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "preview": "pnpm build && node apps/server/scripts/preview.mjs",
    "bench": "pnpm --filter @mon22r/server build && node apps/server/scripts/bench.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
