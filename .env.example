# mon22r settings. Copy to .env (mode 600) and fill in. Never commit the filled file.
# Bank passwords and internet-banking sessions are never stored.

# Required
BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
MINI_APP_URL=https://ledger.example.com
DOMAIN=ledger.example.com

# Optional, shown with their defaults
DATABASE_PATH=./data/mon22r.sqlite
PORT=3000
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# BACKUP_TO_TELEGRAM=on
# FX_REFRESH=on
